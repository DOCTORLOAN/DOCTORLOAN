        <div class="title-product-info">Sản phẩm DOCTORLOAN <span>Sản phẩm được cấp bằng sáng chế độc quyền được bảo hộ trên 62 quốc gia</span></div>
        <div id="productItems" class="row justify-content-center">
            @if (Model?.Products != null && Model.Products.Any())
            {
                @foreach (var product in Model.Products)
                {
                    var price = product.ProductItems?.FirstOrDefault()?.Price ?? product.Price;
                    <div data-id="@product.Id" class="col-xl-2 col-lg-3 col-md-4 col-6 col-20">
                        <div class="product-item">
                            <div class="img-item">
                                <div id="product-@product.Id">
                                    <img loading="lazy" src="@product.ImageUrl" alt="@product.Name" />
                                </div>
                                <div class="content-item">
                                    <h5>
                                        <span>@product.Name</span>
                                        @if (!string.IsNullOrEmpty(product.Summary))
                                        {
                                            <strong>@product.Summary</strong>
                                        }
                                    </h5>
                                    <div id="price-item-@product.Id" class="price-item">@price.ToString("N0")</div>
                                    <div class="action-item">
                                        <a id="addCart-@product.Id" class="icon-cart" href="javascript:void(0)">
                                            <img src="/img/icon/shopping-bag.svg" />
                                        </a>
                                        <a id="buy-@product.Id" data-id="@product.Id" class="btn btn-buy" href="javascript:void(0)">Mua ngay</a>
                                    </div>
                                </div>
                            </div>
                        </div>
