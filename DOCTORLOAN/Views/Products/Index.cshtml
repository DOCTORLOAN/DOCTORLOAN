@section scripts{
    <script type="text/javascript">
        // Handle active menu
        $(document).ready(function () {
            $("#nav-menu-container ul li").removeClass("menu-active");
            $("#nav-menu-container ul li").eq(4).addClass("menu-active");
        });

        // Handle active menu
        $('.btn-gr-dtl').click(function () {
            var parentbtn = $(this).parents(".chat-parent");
            parentbtn.find('.tile-project .btn-group .btn-gr-dtl').removeClass("btn-gr-active");
            $(this).addClass("btn-gr-active");
            var datachart = $(this).data("chart");

            parentbtn.find(".project-chart").removeClass("chart-active-home");
            parentbtn.find(".project-chart." + datachart).addClass("chart-active-home");
        });

        // Handle swiper
        var bannerswiper = new Swiper(".bannerProductSwiper", {
            slidesPerView: 1,
            loop: true,
            autoplay: {
                delay: 3500,
                disableOnInteraction: false,
            },
            pagination: {
                el: ".swiper-pagination",
                clickable: true
            },
        });

        // Handle dropdown menu
        $(".dropdown-menu [data-bs-toggle='dropdown']").on("click", function (event) {
            event.preventDefault();
            event.stopPropagation();

            $(this).parents(".dropdown-menu").first().find(".show").removeClass("show");
            $(this).parents(".dropdown-menu").first().find("[aria-expanded='true']").attr("aria-expanded", false);

            $(this).attr("aria-expanded", true);
            $(this).siblings(".dropdown-menu").toggleClass("show");

            $(this)
                .parents(".nav-item.dropdown")
                .on("hidden.bs.dropdown", function (e) {
                    $(".dropdown-submenu .show").removeClass("show");
                    $(".dropdown-submenu [aria-expanded='true']").attr("aria-expanded", false);
                });
        });

        // Handle redirect to Url with data
        function redirectToWithData(url, data) {
            // Create query parameters obj data
            var queryParams = $.param(data);

            // Handle string query parameters in URL
            var redirectUrl = queryParams ? url + "?" + queryParams : url;

            // Redirect to Url
            window.location.href = redirectUrl;
        }

        // Handle format currency vnd for all price items
        $(document).ready(function () {
            $('.price-item').each(function () {
                var priceText = $(this).text().replace(/[^\d]/g, '');
                if (priceText) {
                    var price = parseInt(priceText);
                    $(this).text(price.toLocaleString('vi', { style: 'currency', currency: 'VND' }));
                }
            });

            // Handle seen details
            $('[id^="product-"]').click(function () {
                var productId = $(this).attr('id').replace('product-', '');
                var data = {
                    productId: productId,
                };
                redirectToWithData("/Products/ProductDetail", data);
            });

            // Handle add to cart
            $('[id^="addCart-"]').click(function () {
                var productId = $(this).attr('id').replace('addCart-', '');
                var existingData = [];

                //Handle save session
                if (sessionStorage.getItem("CartProduct") != undefined && sessionStorage.getItem("CartProduct") != null) {
                    existingData = JSON.parse(sessionStorage.getItem('CartProduct'));
                    var _data = {
                        "id": parseInt(productId),
                        "quantity": 1,
                    };
                    var flag = false;
                    $.each(existingData, function (idx, _item) {
                        if (parseInt(productId) == _item.id) {
                            flag = true;
                            _item.quantity = _item.quantity + 1;
                            sessionStorage.setItem('CartProduct', JSON.stringify(existingData));
                        }
                    });
                    if (flag != true) {
                        existingData.push(_data);
                        sessionStorage.setItem('CartProduct', JSON.stringify(existingData));
                    }
                } else {
                    var data = [{
                        "id": parseInt(productId),
                        "quantity": 1,
                    }];
                    sessionStorage.setItem('CartProduct', JSON.stringify(data));
                }

                new Notify({
                    status: 'success',
                    title: 'Thêm giỏ hàng thành công',
                    text: 'Thêm sản phẩm vào giỏ hàng thành công.',
                    autoclose: true,
                    autotimeout: 3000,
                });
            });

            // Handle buy now
            $('[id^="buy-"]').click(function () {
                var productId = $(this).attr('id').replace('buy-', '');
                var data = {
                    id: parseInt(productId),
                    quantity: 1,
                };
                redirectToWithData("/Cart/Payment", data);
            });
        });

    </script>
}