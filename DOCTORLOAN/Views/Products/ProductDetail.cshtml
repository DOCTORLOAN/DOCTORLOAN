@model DOCTORLOAN.Models.Products.ProductDetailViewModel
@{
    ViewData["Title"] = "Sản phẩm";
}

@{
    var countNum = 5;
}
<input type="hidden" id="txtCountNumber" value="@countNum" />

@await Html.PartialAsync("_LoadingState")

@if (Model != null)
{
    <section id="infoProduct">
        <div class="container">
            <div class="row">
                <div class="col-md-6 col-12">
                    <div class="swiper productSwiperMain">
                        <div id="productSwiperMain" class="swiper-wrapper">
                            @if (Model.ProductMedias != null && Model.ProductMedias.Any())
                            {
                                @foreach (var media in Model.ProductMedias.OrderBy(m => m.OrderBy))
                                {
                                    <div class="swiper-slide">
                                        <img loading="lazy" class="img-product-detail" src="@media.MediaUrl" alt="@Model.Name" />
                                    </div>
                                }
                            }
                            else if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="swiper-slide">
                                    <img loading="lazy" class="img-product-detail" src="@Model.ImageUrl" alt="@Model.Name" />
                                </div>
                            }
                        </div>
                        <div class="swiper-button-next"></div>
                        <div class="swiper-button-prev"></div>
                    </div>
                    <div thumbsSlider="" class="swiper productSwiperThumb">
                        <div id="productSwiperThumb" class="swiper-wrapper">
                            @if (Model.ProductMedias != null && Model.ProductMedias.Any())
                            {
                                @foreach (var media in Model.ProductMedias.OrderBy(m => m.OrderBy))
                                {
                                    <div class="swiper-slide">
                                        <div class="bg-product-thumb">
                                            <img loading="lazy" class="img-thumb-position" src="@media.MediaUrl" alt="@Model.Name" />
                                        </div>
                                    </div>
                                }
                            }
                            else if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="swiper-slide">
                                    <div class="bg-product-thumb">
                                        <img loading="lazy" class="img-thumb-position" src="@Model.ImageUrl" alt="@Model.Name" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-12">
                    <div class="info-product-right">
                        <div class="ipr-name">@Model.Name</div>
                        <div id="iprPrice" class="ipr-price">@Model.Price.ToString("N0")</div>
                        <div id="iprItemColor" class="ipr-item"></div>
                        <div id="iprItemOption" class="ipr-item"></div>
                        <div class="ipr-item">
                            <div>
                                @if (Model.ProductDetails != null && Model.ProductDetails.Any())
                                {
                                    var detail = Model.ProductDetails.First();
                                    <label>.Mô tả</label>
                                    @Html.Raw(detail.Summary)
                                    <br />
                                    <label>.Mô tả chi tiết</label>
                                    @Html.Raw(detail.Description)
                                }
                            </div>
                        </div>
                        <div class="ipr-action-details">
                            <a id="buy-@Model.Id" data-id="@Model.Id" class="btn btn-buy-details" href="javascript:void(0)">Mua ngay</a>
                        </div>
                        <div class="shopify-button" style="display:none;">
                            <div class="action-item custom-action-item action-company action-call">
                                <strong style="font-size: 1.3rem;color: black">Mua dễ dàng hơn bằng</strong>
                                <img loading="lazy" src="/img/icon/shopify.png" style="width: 30%;">
                            </div>
                            <a href="" class="btn btn-outline-dtl btn-shopify" target="_blank">Mua ngay</a>
                        </div>
                        <div class="ipr-policy">
                            <div class="policy-item">
                                <img loading="lazy" src="/img/icon/p-shield.svg" />
                                <span>Cam kết <strong>hàng mới 100%</strong></span>
                            </div>
                            <div class="policy-item">
                                <img loading="lazy" src="/img/icon/p-box-iso.svg" />
                                <span>Bảo hành chính hãng <br /> <a class="btn-seemore" href="javascript:void(0)"></a></span>
                            </div>
                            <div id="policyItem" class="policy-item"></div>
                            <div id="policyItem1" class="policy-item"></div>
                            <div id="policyItem2" class="policy-item"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

