                                            </div>`;
                            imgThumb = `<div class="swiper-slide">
                                            <div class="bg-product-thumb">
                                                <img id="imgThumbPosition`+ (_idx + 1) + `" class="img-thumb-position" src="` + data.data.productMedias[_idx].mediaUrl + `" />
