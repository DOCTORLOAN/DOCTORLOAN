                    $('.product-color').click(function () {
                        var getcolor = $(this).attr("data-color");
                        loadProductForColor(getcolor, data.data);
                    });
                    
                    // Handle buy now
                    $("#buy-" + data.data.id).click(function () {
                        var _data = {
                            id: data.data.id,
                            quantity: 1,
                        };
                        redirectToWithData("/Cart/Payment", _data);
