@if (Model?.RelatedProducts != null && Model.RelatedProducts.Any())
{
    <section id="ProductBestSeller" class="product-wrapper">
        <div class="container">
            <div class="title-product-info">
                <h4>Sản phẩm DOCTORLOAN</h4>
                <span>Sản phẩm được cấp bằng sáng chế độc quyền được bảo hộ trên 62 quốc gia</span>
            </div>
            <div id="itemBestSeller" class="row justify-content-center">
                @foreach (var product in Model.RelatedProducts)
                {
                    var price = product.ProductItems?.FirstOrDefault()?.Price ?? product.Price;
                    <div data-id="@product.Id" class="col-xl-2 col-lg-3 col-md-4 col-6 col-20">
                        <div class="product-item">
                            <div class="img-item">
                                <div id="product-@product.Id">
                                    <img loading="lazy" src="@product.ImageUrl" alt="@product.Name" />
                                </div>
                                <div class="content-item">
                                    <h5>
                                        <span>@product.Name</span>
                                        @if (!string.IsNullOrEmpty(product.Summary))
                                        {
                                            <strong>@product.Summary</strong>
                                        }
                                    </h5>
                                    <div id="price-item-@product.Id" class="price-item">@price.ToString("N0")</div>
                                    <div class="action-item">
                                        <a id="buy-@product.Id" data-id="@product.Id" class="btn btn-buy" href="javascript:void(0)">Mua ngay</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@section scripts {
    <script type="text/javascript">

        function querySelectorAll(e) {  
            document.querySelectorAll(e).forEach(function (title) {
                title.addEventListener('click', function () {
                    var ulist = this.nextElementSibling;
                    var icon = this.querySelector('.icon');
                    if (ulist.classList.contains('show')) {
                        ulist.classList.remove('show');
                        icon.textContent = '+';
                    } else {
                        ulist.classList.add('show');
                        icon.textContent = '-';
                    }
                });
                // Auto scroll behavior
                if (content.classList.contains('show-content')) {
                    content.scrollIntoView({ behavior: 'smooth' });
                } else {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
        }

        $(document).ready(function () {
            $("#nav-menu-container ul li").removeClass("menu-active");
            $("#nav-menu-container ul li").eq(4).addClass("menu-active");
        });

        var _sku135 = "LC35LESY";
        var _sku90 = "SC90DESY";
        var _sku90BL = "SC90OEBL";
        var _sku90T = "SC90TESY";
        var _sku95 = "SC95VESY";
        var _skuN85 = "PL85SFOR";
        var _skuF4 = "NP04SEFY";
        var _skuF5 = "NP05SEFY";
        var _skuF6 = "NP06SEFY";
        var _skuF3 = "BP03CEFY";
        var _skuLF4 = "BP04OEFY";
        var _skuF1 = "BP01LEFY";
        var _skuDT = "SDNLSESY";
        var _skuGCSS = "NP00OEFY";
        var _skuGC26 = "NP26SEFY";
        var _skuGC61 = "NP61SEFY";
        var _skuGC = "NP00SEFY";
        var _skuGCNL = "NPAUNEFY";
        var _skuGCDL = "NPTLSEFY";
        var _skuGCDX = "NPCROEFY";

        $(document).on("click", ".btn-seemore", function () {
            var parentbtn = $(this).parents(".pd-button-overlay");
            parentbtn.hide();
            $(".accordion-product").addClass("expand");
        });

        //Function get parameter in url
        function getParam(name, url) {
            if (!url) url = window.location.href;
            name = name.replace(/[\[\]]/g, '\\$&');
            var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
                results = regex.exec(url);
            if (!results) return null;
            if (!results[2]) return '';
            return decodeURIComponent(results[2].replace(/\+/g, ' '));
        }

        function redirectToWithData(url, data) {
            // Create query parameters obj data
            var queryParams = $.param(data);

            // Handle string query parameters in URL
            var redirectUrl = queryParams ? url + "?" + queryParams : url;

            // Redirect to Url
            window.location.href = redirectUrl;
        }

        // Initialize product detail page
        $(document).ready(function () {
            @if (Model != null)
            {
                <text>
                var productSku = '@Model.Sku';
                var productId = @Model.Id;
                var productName = '@Html.Raw(Model.Name.Replace("'", "\\'"))';

                // Format currency
                $('#iprPrice').each(function () {
                    var priceText = $(this).text().replace(/[^\d]/g, '');
                    if (priceText) {
                        var price = parseInt(priceText);
                        $(this).text(price.toLocaleString('vi', { style: 'currency', currency: 'VND' }));
                    }
                });

                // Initialize Swiper
                var swiper = new Swiper(".productSwiperThumb", {
                    loop: false,
                    spaceBetween: 12,
                    slidesPerView: 5,
                    freeMode: true,
                    watchSlidesProgress: true,
                    autoplay: {
                        delay: 2500,
                        disableOnInteraction: false,
                    },
                });

                var swiper2 = new Swiper(".productSwiperMain", {
                    loop: false,
                    spaceBetween: 0,
                    autoplay: {
                        delay: 2500,
                        disableOnInteraction: false,
                    },
                    navigation: {
                        nextEl: ".swiper-button-next",
                        prevEl: ".swiper-button-prev",
                    },
                    thumbs: {
                        swiper: swiper,
                    },
                });

                // Setup product options and colors based on SKU
                setupProductOptions(productSku, productName);
                setHrefHDSD(productSku);
                setHrefShopify(productSku);

                // Handle buy now
                $("#buy-" + productId).click(function () {
                    var _data = {
                        id: productId,
                        quantity: 1,
                    };
                    redirectToWithData("/Cart/Payment", _data);
                });
                </text>
            }
        });

        function setupProductOptions(sku, productName) {
            var _sku135 = "LC35LESY";
            var _sku90 = "SC90DESY";
            var _sku90T = "SC90TESY";
            var _sku95 = "SC95VESY";
            var _skuN85 = "PL85SFOR";
            var _skuF1 = "BP01LEFY";
            var _skuDT = "SDNLSESY";

            if (sku === _skuDT) {
                $("#iprItemOption").append(`<label>.Tuỳ chọn</label>
                    <div class="form-check">
                        <input class="form-check-input option-dt" type="radio" name="flexRadioOption" id="dtL">
                        <label class="form-check-label" for="dtL">Lớn</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input option-dt" type="radio" name="flexRadioOption" id="dtS" checked>
                        <label class="form-check-label" for="dtS">Nhỏ</label>
                    </div>`);
                $('.option-dt').click(function () {
                    if ($('#dtL').is(':checked')) {
                        $('#iprPrice').text("6500000");
                    } else {
                        $('#iprPrice').text("6000000");
                    }
                    $('#iprPrice').text(parseInt($('#iprPrice').text()).toLocaleString('vi', { style: 'currency', currency: 'VND' }));
                });
            }

            if (sku === _skuF1) {
                $("#iprItemOption").append(`<label>.Tuỳ chọn</label>
                    <div class="form-check">
                        <input class="form-check-input option-f1" type="radio" name="flexRadioOption" id="f1L">
                        <label class="form-check-label" for="f1L">Dài</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input option-f1" type="radio" name="flexRadioOption" id="f1S" checked>
                        <label class="form-check-label" for="f1S">Ngắn</label>
                    </div>`);
                $('.option-f1').click(function () {
                    if ($('#f1L').is(':checked')) {
                        $('#iprPrice').text("2875000");
                    } else {
                        $('#iprPrice').text("1437000");
                    }
                    $('#iprPrice').text(parseInt($('#iprPrice').text()).toLocaleString('vi', { style: 'currency', currency: 'VND' }));
                });
            }

            if (sku === _sku135 || sku === _sku95 || sku === _sku90 || sku === _sku90T) {
                $("#iprItemColor").append(`<label>.Màu sắc</label>
                    <div class="ipr-color">
                        <a href="javascript:void(0)" class="product-color brown active" data-color="`+ productName + `/Y" title="Màu nâu"></a>
                        <a href="javascript:void(0)" class="product-color grape" data-color="`+ productName + `/P" title="Màu nho"></a>
                        <a href="javascript:void(0)" class="product-color black" data-color="`+ productName + `/B" title="Màu đen"></a>
                        <a href="javascript:void(0)" class="product-color green" data-color="`+ productName + `/G" title="Màu xanh"></a>
                    </div>`);
            }

            if (sku === _skuN85) {
                $("#iprItemColor").append(`<label>.Màu sắc</label>
                    <div class="ipr-color">
                        <a href="javascript:void(0)" class="product-color yellow active" data-color="`+ productName + `-S/YL" title="Màu vàng"></a>
                        <a href="javascript:void(0)" class="product-color orange" data-color="`+ productName + `-S/OR" title="Màu cam"></a>
                        <a href="javascript:void(0)" class="product-color red" data-color="`+ productName + `-S/RE" title="Màu đỏ"></a>
                        <a href="javascript:void(0)" class="product-color gray" data-color="`+ productName + `-S/GR" title="Màu xám"></a>
                        <a href="javascript:void(0)" class="product-color green" data-color="`+ productName + `-S/GE" title="Màu xanh lá"></a>
                        <a href="javascript:void(0)" class="product-color blue" data-color="`+ productName + `-S/BL" title="Màu xanh dương"></a>
                    </div>`);
                $("#iprItemOption").append(`<label>.Tuỳ chọn</label>
                    <div class="form-check">
                        <input class="form-check-input option-n85" type="radio" name="flexRadioOption" value="Chân dài" id="n85-L">
                        <label class="form-check-label" for="n85-L">Chân dài</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input option-n85" type="radio" name="flexRadioOption" value="Chân ngắn" id="n85-S" checked>
                        <label class="form-check-label" for="n85-S">Chân ngắn</label>
                    </div>`);
                $('.option-n85').click(function () {
                    if ($('#n85-L').is(':checked')) {
                        $('#iprPrice').text("2300000");
                    } else {
                        $('#iprPrice').text("2127000");
                    }
                    $('#iprPrice').text(parseInt($('#iprPrice').text()).toLocaleString('vi', { style: 'currency', currency: 'VND' }));
                });
            }
        }

        //handle get Attributes
        function loadAttributes(_attr, _item) {

            switch (_attr) {
                case 1:
                    var attr = ``;
                    attr = `<li>
                            <div class="ctLeft">
                                <p>Kích thước: </p>
                            </div>
                            <div class="ctRight">
                                <span>`+ _item +`</span>
                            </div>
                        </li>`;
                    $("#attributesItem").append(attr);
                    break;
                case 2:
                    var attr = ``;
                    attr = `<li>
                                <div class="ctLeft">
                                    <p>Khối lượng: </p>
                                </div>
                                <div class="ctRight">
                                    <span>`+ _item + `</span>
                                </div>
                            </li>`;
                    $("#attributesItem").append(attr);
                    break;
                case 3:
                    var attr = ``;
                    attr = `<li>
                                <div class="ctLeft">
                                    <p>Kiểu dáng: </p>
                                </div>
                                <div class="ctRight">
                                    <span>`+ _item + `</span>
                                </div>
                            </li>`;
                    $("#attributesItem").append(attr);
                    break;
                case 4:
                    var attr = ``;
                    attr = `<li>
                                <div class="ctLeft">
                                    <p>Chất liệu lõi: </p>
                                </div>
                                <div class="ctRight">
                                    <span>`+ _item + `</span>
                                </div>
                            </li>`;
                    $("#attributesItem").append(attr);
                    break;
                case 5:
                    var attr = ``;
