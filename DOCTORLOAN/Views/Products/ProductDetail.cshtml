                                    $('#iprPrice').text("1320000");
                                }
                                $('#iprPrice').text(parseInt($('#iprPrice').text()).toLocaleString('vi', { style: 'currency', currency: 'VND' }));
                            });
                        }

                        $.each(data.data.productMedias, function (_idx, _item) {
                            if (_item.itemCode == data.data.sku) {
                                _arr.push(_item);
