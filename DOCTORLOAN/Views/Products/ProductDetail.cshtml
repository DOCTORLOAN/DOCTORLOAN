                                                                        `+ data.data.productDetails[0].description + `
                                                                    </div>
                                                                </div>
                                                                <div class="ipr-action-details">
                                                                    @* <a href="javascript:void(0)" class="btn btn-dtl">Thêm vào giỏ hàng</a> *@
