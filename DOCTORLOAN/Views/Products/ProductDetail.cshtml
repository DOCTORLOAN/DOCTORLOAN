@section scripts {
    <script type="text/javascript">

        function querySelectorAll(e) {  
            document.querySelectorAll(e).forEach(function (title) {
                title.addEventListener('click', function () {
                    var ulist = this.nextElementSibling;
                    var icon = this.querySelector('.icon');
                    if (ulist.classList.contains('show')) {
                        ulist.classList.remove('show');
                        icon.textContent = '+';
                    } else {
                        ulist.classList.add('show');
                        icon.textContent = '-';
                    }
                });
                // Auto scroll behavior
                if (content.classList.contains('show-content')) {
                    content.scrollIntoView({ behavior: 'smooth' });
                } else {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
        }

        $(document).ready(function () {
            $("#nav-menu-container ul li").removeClass("menu-active");
            $("#nav-menu-container ul li").eq(4).addClass("menu-active");
        });

