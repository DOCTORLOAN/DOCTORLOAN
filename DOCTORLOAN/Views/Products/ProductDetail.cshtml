                case _sku135:
                    _href = "https://doctorloanstore.myshopify.com/products/135-doctorloan-chair";
                    break;
                case _sku90:
                    _href = "https://doctorloanstore.myshopify.com/products/90-doctorloan-chair";
                    break;
                case _sku90T:
                    _href = "https://doctorloanstore.myshopify.com/products/90-doctorloan-thin-chair";
                    break;
                case _sku95:
                    _href = "https://doctorloanstore.myshopify.com/products/95v-doctorloan-chair";
                    break;
                case _skuN85:
                    _href = "https://doctorloanstore.myshopify.com/products/n85-doctorloan-chair";
                    break;
                case _skuF3:
                    _href = "https://doctorloanstore.myshopify.com/products/f3-pillow";
                    break;
                case _skuF1:
                    _href = "https://doctorloanstore.myshopify.com/products/f1-pillow";
                    break;
                case _skuF4:
                    _href = "https://doctorloanstore.myshopify.com/products/f4-pillow";
                    break;
                case _skuDT:
                    _href = "https://doctorloanstore.myshopify.com/products/meditation-cushion-doctorloan";
                    break;
                default:
                    shouldShowButton = false;
                    break;
            }

            if (shouldShowButton) {
                $(".shopify-button").show();
            } else {
                $(".shopify-button").hide();
            }

            return $(".btn-shopify").attr("href", _href);
        }

        // Handle related products (Best Seller) - already rendered from server
        $(document).ready(function () {
            // Format currency for related products
            $('#itemBestSeller .price-item').each(function () {
                var priceText = $(this).text().replace(/[^\d]/g, '');
                if (priceText) {
                    var price = parseInt(priceText);
                    $(this).text(price.toLocaleString('vi', { style: 'currency', currency: 'VND' }));
                }
            });

            // Handle seen details for related products
            $('#itemBestSeller [id^="product-"]').click(function () {
                var productId = $(this).attr('id').replace('product-', '');
                var data = {
                    productId: productId,
                };
                redirectToWithData("/Products/ProductDetail", data);
            });

            // Handle buy now for related products
            $('#itemBestSeller [id^="buy-"]').click(function () {
                var productId = $(this).attr('id').replace('buy-', '');
                var data = {
                    id: parseInt(productId),
                    quantity: 1,
                };
                redirectToWithData("/Cart/Payment", data);
            });
        });

    </script>
}
