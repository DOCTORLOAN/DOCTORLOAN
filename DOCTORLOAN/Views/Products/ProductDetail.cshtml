                        slidesPerView: 5,
                        freeMode: true,
                        watchSlidesProgress: true,
                        autoplay: {
                            delay: 2500,
                            disableOnInteraction: false,
                        },
                    });

                    var swiper2 = new Swiper(".productSwiperMain", {
                        loop: false,
                        spaceBetween: 0,
                        autoplay: {
                            delay: 2500,
                            disableOnInteraction: false,
                        },
                        navigation: {
