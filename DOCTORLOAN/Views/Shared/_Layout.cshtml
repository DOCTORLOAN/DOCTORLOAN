<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="facebook-domain-verification" content="1te1j7yiuwa5e0as1tszd540epeul7" />
    <title>@ViewData["Title"] - Công ty TNHH Gia Thái DOCTORLOAN</title>
    <meta name="google-site-verification" content="0dwDQPx-V8Q03sncbrL3ktvKOZpWjgm4E5wmi9kJOMI" />
    <link href="./libs/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="./libs/glightbox/glightbox.min.css" rel="stylesheet" />
    <link href="./libs/owlcarousel/owl.carousel.min.css" rel="stylesheet" />
    <link href="./libs/swiperjs/swiper-bundle.min.css" rel="stylesheet" />
    <link href="./libs/font-awesome_4.5/css.css" rel="stylesheet" />
    <link href="./libs/font-awesome_4.5/font-awesome.min.css" rel="stylesheet" />
    <link href="./libs/font-awesome_5.15.1/font-awesome_5.15.1_css_all.min.css" rel="stylesheet" />
    <link href="./css/styles.min.css" rel="stylesheet" />
    <link href="./libs/flatpickr/flatpickr.min.css" rel="stylesheet" />
    <link href="./libs/ajax/tailwind.min.css" rel="stylesheet" />
</head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-XHPGS4R7MQ"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());

    gtag('config', 'G-XHPGS4R7MQ');
</script>
<body>
    <header>
        @await Html.PartialAsync("/Views/Common/_HeaderPartial.cshtml")
    </header>
    <main>
        @RenderBody()

        <div class="modal" id="myModal" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    @await Component.InvokeAsync("NewsModal")
                </div>
            </div>
        </div>

        <div class="zalo-chat-widget" data-oaid="3997762822356581117" data-welcome-message="DOCTORLOAN Rất vui khi được hỗ trợ bạn!" data-autopopup="2" data-width="" data-height=""></div>
        
    </main>
    <footer>
        @await Html.PartialAsync("/Views/Common/_FooterPartial.cshtml")
    </footer>

    <script src="./libs/jquery/jquery-3.7.0.min.js"></script>
    <script src="./js/common.js"></script>
    <script src="./libs/swiperjs/swiper-bundle.min.js"></script>
    <script src="./libs/Bootstrap/popper.min.js"></script>
    <script src="./libs/Bootstrap/bootstrap.min.js"></script>
    <script src="./libs/superfish/hoverintent.js"></script>
    <script src="./libs/superfish/superfish.min.js"></script>
    <script src="./libs/glightbox/glightbox.min.js"></script>
    <script src="./libs/owlcarousel/owl.carousel.min.js"></script>
    <script src="./libs/Bootstrap/bootstrap-datepicker.js"></script>
    <script src="./libs/Bootstrap/bootstrap-datepicker.vi.min.js"></script>
    <script src="./libs/Bootstrap/bootstrap-datetimepicker.js"></script>
    <script src="./libs/flatpickr/flatpickr.js"></script>
    <script src="./libs/chart/chart.js"></script>
    <script src="./libs/youtube/iframe_api.js"></script>
    <script src="./libs/zalo/sdk.js"></script>
    <script>
        // Function để chuyển hướng
        function redirectToWithData(url, data) {
            const queryParams = $.param(data);
            const redirectUrl = queryParams ? `${url}?${queryParams}` : url;
            window.location.href = redirectUrl;
        }

        // Event handler để đóng modal
        $(document).on('click', '#myModal .close', function () {
            $('#myModal').modal('hide');
        });

        // Hiển thị modal khi trang load xong (nếu có news data từ server)
        $(document).ready(function () {
            // Chỉ show modal nếu modal-content có nội dung (có news item)
            if ($('#myModal .modal-content .modal-header').length > 0 && $('#myModal .modal-content .modal-header .modal-title').text().trim() !== '') {
                $('#myModal').modal('show');
            }
        });
    </script>
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
