<body>
    <header>
        @await Html.PartialAsync("/Views/Common/_HeaderPartial.cshtml")
    </header>
    <main>
        @RenderBody()

        <div class="modal" id="myModal" tabindex="-1" role="dialog" aria-hidden="true" aria-labelledby="myModalLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    @await Component.InvokeAsync("NewsModal")
                </div>
            </div>
        </div>

        <div class="zalo-chat-widget" data-oaid="3997762822356581117" data-welcome-message="DOCTORLOAN Rất vui khi được hỗ trợ bạn!" data-autopopup="2" data-width="" data-height=""></div>
        
    </main>
    <footer>
        @await Html.PartialAsync("/Views/Common/_FooterPartial.cshtml")
    </footer>

    <script src="~/libs/jquery/jquery-3.7.0.min.js"></script>
    <script src="~/js/common.js"></script>
    <script src="~/libs/swiperjs/swiper-bundle.min.js"></script>
    <script src="~/libs/Bootstrap/popper.min.js"></script>
    <script src="~/libs/Bootstrap/bootstrap.min.js"></script>
    <script src="~/libs/SuperFish/hoverIntent.js"></script>
    <script src="~/libs/SuperFish/superfish.min.js"></script>
    <script src="~/libs/glightbox/glightbox.min.js"></script>
    <script src="~/libs/OwlCarousel/owl.carousel.min.js"></script>
    <script src="~/libs/Bootstrap/bootstrap-datepicker.js"></script>
    <script src="~/libs/Bootstrap/bootstrap-datepicker.vi.min.js"></script>
    <script src="~/libs/Bootstrap/bootstrap-datetimepicker.js"></script>
    <script src="~/libs/flatpickr/flatpickr.js"></script>
    <script src="~/libs/chart/chart.js"></script>
    <script src="~/libs/youtube/iframe_api.js"></script>
    <script src="~/libs/zalo/sdk.js"></script>
    <script>
        // Function để chuyển hướng
        function redirectToWithData(url, data) {
            const queryParams = $.param(data);
            const redirectUrl = queryParams ? `${url}?${queryParams}` : url;
            window.location.href = redirectUrl;
        }

        // Event handler để đóng modal
        $(document).on('click', '#myModal .close', function () {
            $('#myModal').modal('hide');
        });

        // Fix ARIA accessibility: Ensure aria-hidden is properly managed
        // Use both 'show' and 'shown' events to catch the modal at different stages
        $('#myModal').on('show.bs.modal', function () {
            $(this).removeAttr('aria-hidden');
        });

        $('#myModal').on('shown.bs.modal', function () {
            var $modal = $(this);
            $modal.removeAttr('aria-hidden');
            // Additional safeguard: check again after a short delay
            setTimeout(function() {
                if ($modal.is(':visible') && $modal.attr('aria-hidden') === 'true') {
                    $modal.removeAttr('aria-hidden');
                }
            }, 10);
        });

        $('#myModal').on('hide.bs.modal', function () {
            $(this).attr('aria-hidden', 'true');
        });

        $('#myModal').on('hidden.bs.modal', function () {
            $(this).attr('aria-hidden', 'true');
        });

        // MutationObserver to catch any aria-hidden changes made by Bootstrap after our handlers
        if (typeof MutationObserver !== 'undefined') {
            var modalElement = document.getElementById('myModal');
            if (modalElement) {
                var observer = new MutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                        if (mutation.type === 'attributes' && mutation.attributeName === 'aria-hidden') {
                            var modal = mutation.target;
                            var style = window.getComputedStyle(modal);
                            var isVisible = style.display !== 'none' && style.visibility !== 'hidden';
                            // If modal is visible but has aria-hidden="true", remove it
                            if (isVisible && modal.getAttribute('aria-hidden') === 'true') {
                                modal.removeAttribute('aria-hidden');
                            }
                        }
                    });
                });
                observer.observe(modalElement, {
                    attributes: true,
                    attributeFilter: ['aria-hidden']
                });
            }
        }

        // Hiển thị modal khi trang load xong (nếu có news data từ server)
        $(document).ready(function () {
            // Chỉ show modal nếu modal-content có nội dung (có news item)
            if ($('#myModal .modal-content .modal-header').length > 0 && $('#myModal .modal-content .modal-header .modal-title').text().trim() !== '') {
                $('#myModal').modal('show');
            }
        });
    </script>
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
