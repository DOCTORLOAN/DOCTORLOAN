<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="facebook-domain-verification" content="1te1j7yiuwa5e0as1tszd540epeul7" />
    <title>@ViewData["Title"] - Công ty TNHH Gia Thái DOCTORLOAN</title>
    <meta name="google-site-verification" content="0dwDQPx-V8Q03sncbrL3ktvKOZpWjgm4E5wmi9kJOMI" />
    <link href="~/libs/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/libs/glightbox/glightbox.min.css" rel="stylesheet" />
    <link href="~/libs/owlcarousel/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/libs/swiperjs/swiper-bundle.min.css" rel="stylesheet" />
    <link href="~/libs/font-awesome_4.5/font-awesome.min.css" rel="stylesheet" />
    <link href="~/libs/font-awesome_5.15.1/font-awesome_5.15.1_css_all.min.css" rel="stylesheet" />
    <link href="~/css/styles.min.css" rel="stylesheet" />
    <link href="~/libs/flatpickr/flatpickr.min.css" rel="stylesheet" />
    <link href="~/libs/ajax/tailwind.min.css" rel="stylesheet" />
</head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-XHPGS4R7MQ"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());

    gtag('config', 'G-XHPGS4R7MQ');
</script>
<body>
    <header>
        @await Html.PartialAsync("/Views/Common/_HeaderPartial.cshtml")
    </header>
    <main>
        @RenderBody()

        <div class="modal" id="myModal" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"></h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body"></div>
                    <div class="modal-footer"></div>
                </div>
            </div>
        </div>

        <div class="zalo-chat-widget" data-oaid="3997762822356581117" data-welcome-message="DOCTORLOAN Rất vui khi được hỗ trợ bạn!" data-autopopup="2" data-width="" data-height=""></div>
        
    </main>
    <footer>
        @await Html.PartialAsync("/Views/Common/_FooterPartial.cshtml")
    </footer>

    <script src="~/libs/jquery/jquery-3.7.0.min.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/common.js"></script>
    <script src="~/libs/swiperjs/swiper-bundle.min.js"></script>
    <script src="~/libs/swiperjs/swiper-bundle.min.js.map"></script>
    <script src="~/libs/Bootstrap/popper.min.js"></script>
    <script src="~/libs/Bootstrap/bootstrap.min.js"></script>
    <script src="~/libs/superfish/hoverintent.js"></script>
    <script src="~/libs/superfish/superfish.min.js"></script>
    <script src="~/libs/glightbox/glightbox.min.js"></script>
    <script src="~/libs/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/libs/Bootstrap/bootstrap-datepicker.js"></script>
    <script src="~/libs/Bootstrap/bootstrap-datepicker.vi.min.js"></script>
    <script src="~/libs/Bootstrap/bootstrap-datetimepicker.js"></script>
    <script src="~/libs/flatpickr/flatpickr.js"></script>
    <script src="~/libs/font-awesome_4.5/fontawesome-webfont.woff"></script>
    <script src="~/libs/font-awesome_4.5/fontawesome-webfont.woff2"></script>
    <script src="~/libs/chart/chart.js"></script>
    <script src="~/libs/youtube/iframe_api.js"></script>
    <script src="~/libs/zalo/sdk.js"></script>
    <script>
        // Function để chuyển hướng
        function redirectToWithData(url, data) {
            const queryParams = $.param(data);
            const redirectUrl = queryParams ? `${url}?${queryParams}` : url;
            window.location.href = redirectUrl;
        }

        // Hàm xử lý việc hiển thị modal khi trang tải xong
        $(document).ready(function () {
            let keyword = "Kinh doanh";
            getNews(keyword);

            $('#myModal').modal('show');
        });

        $("#myModal .close").click(function () {
            $('#myModal').modal('hide');
        });

        // Get the News section of the Reason category
        function getNews(keyword) {
            $.ajax({
                url: `https://doctorloan-api.giathaidoctorloan.vn/api/news-module/NewsItem/FilterNews?Keyword=${keyword}`,
                type: 'GET',
                dataType: 'json',
                success: function (data) {

                    // XÓA BỎ nội dung cũ TRƯỚC KHI thêm nội dung mới
                    $("#myModal .modal-title").empty();
                    $("#myModal .modal-body").empty();
                    $("#myModal .modal-footer").empty();

                    // CHỈ LẤY TIN TỨC ĐẦU TIÊN để hiển thị trong modal
                    if (data.data.items && data.data.items.length > 0) {

                        const _item = data.data.items[0]; // Lấy tin tức đầu tiên

                        // 1. Thêm tiêu đề
                        $("#myModal .modal-title").append(`<h5 class="modal-title">${_item.title}</h5>`);

                        // 2. Thêm hình ảnh
                        $("#myModal .modal-body").append(`<img src='${_item.imageUrl}' class="img-fluid" />`);

                        // 3. Thêm nút hành động (Xem chi tiết)
                        const footerContent = `<div class="more-action">
                                                <a class="btn btn-outline-secondary rounded-pill" id="newsDetails-${_item.id}">Xem chi tiết</a>
                                              </div>`;
                        $("#myModal .modal-footer").append(footerContent);

                        // 4. Gắn sự kiện click vào nút mới được thêm
                        $(`#newsDetails-${_item.id}`).click(function () {
                            redirectToWithData("/News/NewsDetail", { newsId: _item.id });
                        });
                    } else {
                        // Nếu không có tin tức, có thể đóng modal hoặc thông báo lỗi
                        $('#myModal').modal('hide');
                    }

                },
                error: function (error) {
                    console.error('Error fetching news:', error);
                    $('#myModal').modal('hide');
                }
            });
        }
    </script>
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
