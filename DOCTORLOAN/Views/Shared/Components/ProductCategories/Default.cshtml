@model List<DOCTORLOAN.Models.Api.CategoryResponse>

@if (Model != null && Model.Any())
{
    @foreach (var category in Model)
    {
        <div id="categories-@category.Id" class="swiper-slide swiper-slide_item" style="max-width: 15%" data-category-id="@category.Id">
            @Html.Raw(category.Content)
        </div>
    }
}

