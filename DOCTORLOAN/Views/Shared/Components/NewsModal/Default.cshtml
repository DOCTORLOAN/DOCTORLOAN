@model DOCTORLOAN.Models.Api.NewsItemResponse?

@if (Model != null)
{
    <div class="modal-header">
        <h5 class="modal-title">@Html.Raw(Model.Title)</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    <div class="modal-body">
        <img src="@Model.ImageUrl" class="img-fluid" alt="@Model.Title" loading="lazy" />
    </div>
    <div class="modal-footer">
        <div class="more-action">
            <a class="btn btn-outline-secondary rounded-pill" asp-controller="News" asp-action="NewsDetail" asp-route-newsId="@Model.Id">Xem chi tiết</a>
        </div>
    </div>
}

