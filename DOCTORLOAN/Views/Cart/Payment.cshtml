                        var _sku = data.name + _option + _color;
                        $.each(data.productItems, function (idx, item) {
                            if (item.sku === _sku) {
                                _flagSku = item.sku;
                            }
                        });
                        calculatePrice(_flagSku, $('#quantityPayment-' + productId).val(), data);
                    });
