                error: function (error) {
                    //handle show error
                    console.error('Error:', error);
                }
            });
        }

        //handle show alert
        window.setTimeout(function () {
            $(".alert").fadeTo(500, 0).slideUp(500, function () {
                $(this).remove();
            });
        }, 3000);

        var _dataRes = $("#dataRes").val();

        //Validation
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();

                        _custommerName = $("#fullName").val();
                        _phone = $("#phone").val();
                        _email = $("#email").val();
                        _addres = $("#addressLine").val();
                    }
                    form.classList.add('was-validated');
                }, false);

            })
        })();

        // Handle redirect to Url with data
        function redirectToWithData(url, data) {
            // Create query parameters obj data
            var queryParams = $.param(data);

            // Handle string query parameters in URL
            var redirectUrl = queryParams ? url + "?" + queryParams : url;

            // Redirect to Url
            window.location.href = redirectUrl;
        }

        //handle calculate price
        function calculatePrice(_price, _quantity) {
            var _subTotal = _price * _quantity;
            $("#cart-subtotal").html(_subTotal);
        }

        //handle call API checkout
        if (_dataRes != undefined && _phone != null && _custommerName != null && _address != null) {
            var _res = JSON.parse(_dataRes);
            //Payment Payoo
            var _baseUrl = "https://payoo.vn/v2/";
            const _businessUsername = "PY8_DOCTORLOAN_ECOM";
            const _shopID = "6587";
            const _shopTitle = "DOCTORLOAN";
            const _checksumKey = "ySpkGehhqJcLuniNYGZZJO8IAftdXc3HxBFvGJgyeMPpPcFk8i+z9ywiCcq53kuv8C8rMm8pnOypibnXIw2/Nw==";
            const _apiUsername = "PY8_DOCTORLOAN_ECOM_BizAPI";
            const _apiPassword = "MTwmyaC3H8FQxCb6";
            const _apiSignature = "h9yQ5+wZC2nEvpCodoW1cnp6JTYz5ezKaJgNoyGzOqerArpKtdiIh+/7oN1i3ncw";
            const _domain = "https://doctorloan.vn/";

            //function sha512 checksum
            function sha512(strCheckSumKey, strXML) {
                var combinedString = strCheckSumKey + strXML;
                var checksum = CryptoJS.SHA512(combinedString).toString();
                return checksum;
            }

            const now = new Date();

            //function get current date time formatted
            function getCurrentDateTimeFormatted() {
                const year = now.getFullYear();
                const month = (now.getMonth() + 1).toString().padStart(2, '0');
                const day = now.getDate().toString().padStart(2, '0');
                const hours = (now.getHours() + 1).toString().padStart(2, '0');
                const minutes = now.getMinutes().toString().padStart(2, '0');
                const seconds = now.getSeconds().toString().padStart(2, '0');

                return `${year}${month}${day}${hours}${minutes}${seconds}`;
            }

            //function get current date formatted
            function getCurrentDateFormatted() {
                const day = now.getDate().toString().padStart(2, '0');
                const month = (now.getMonth() + 1).toString().padStart(2, '0');
                const year = now.getFullYear();

                return `${day}/${month}/${year}`;
            }

            const _validityTime = getCurrentDateTimeFormatted();
            const _orderDate = getCurrentDateFormatted();
            var _orderNo = "ORD_" + _shopID + "_" + _res.data.orderNo;
            var _data = "<shops><shop><username>" + _businessUsername + "</username><shop_id>" + _shopID + "</shop_id>" +
                "<shop_title>" + _shopTitle + "</shop_title><shop_domain>" + _domain + "</shop_domain>" +
                "<order_no>" + _orderNo + "</order_no><order_cash_amount>" + _res.data.totalPrice + "</order_cash_amount>" +
                "<order_ship_date>" + _orderDate + "</order_ship_date><order_ship_days>0</order_ship_days>" +
                "<order_description>Mã đơn hàng: " + _res.data.orderNo + " Tổng tiền: " + _res.data.totalPrice.toLocaleString('vi', { style: 'currency', currency: 'VND' }) + "</order_description>" +
                "<shop_back_url>https://doctorloan.vn/common/OrderSuccess</shop_back_url>" +
                "<notify_url>https://doctorloan-api.giathaidoctorloan.vn/api/order-module/Order/callback-payoo</notify_url>" +
                "<validity_time>" + _validityTime + "</validity_time><customer>" +
                "<name>" + _custommerName + "</name><phone>"+_phone+"</phone><address>"+_address+"</address>" +
                "<email>" + _email + "</email></customer><JsonResponse>true</JsonResponse><direct_return_time>5</direct_return_time></shop></shops>";

            //function call API checkout
            $.ajax({
                url: _baseUrl + "create-preorder",
                type: 'POST',
                data: {
                    "data": _data,
                    "checksum": sha512(_checksumKey, _data),
                    "refer": _domain,
                    "payment_group": ""
                },
                success: function (response) {
                    window.location.href = response.order.payment_url;
                },
                error: function (xhr, status, error) {
                    console.error('Có lỗi khi gửi yêu cầu API error:', error);
                }
            });
        }
        
    </script>
}