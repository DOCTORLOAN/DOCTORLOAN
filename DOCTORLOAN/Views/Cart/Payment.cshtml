@using DOCTORLOAN.Models.Orders;
@{
    ViewData["Title"] = "Thanh Toán";
}
<section id="CartPayment" class="cart-payment">
    <div class="container">
        <div class="row">
            <form method="post" asp-controller="Cart" asp-action="PaymentPost" class="row needs-validation" novalidate>
                <div id="alert" class="alert alert-error">
                    @if (TempData["AlertMessageError"] != null)
                    {
                        <div class="alert alert-warning">
                            @TempData["AlertMessageError"]
                        </div>
                    }
                   
                </div>
                 @if (TempData["AlertMessageError"] != null)
                {
                    <input type="text" class="form-control" value="@TempData["id"]" id="idProduct" hidden />
                    <input type="text" class="form-control" value="@TempData["quantity"]" id="qProduct" hidden />
                }
                <div class="col-lg-7">
                    <div class="cart-wrapper">
                        <div class="title-cart">Thông tin đơn hàng</div>
                        <div class="cart-link">Đã có tài khoản?&nbsp; <a asp-controller="Auth" asp-action="Login">Đăng nhập</a></div>
                        <div class="cart-form">
                            <div class="mb-3">
                                <label for="fullName" class="req">Tên người nhận</label>
                                <input type="text" class="form-control" placeholder="Nhập tên người nhận" name="FullName" id="fullName" required />
                                <div class="invalid-feedback">
                                    Vui lòng nhập họ tên.
                                </div>
                            </div>

                            <div class="row">
                                <div class="mb-3 col-6">
                                    <label for="phone" class="req">Số điện thoại</label>
                                    <input type="text" class="form-control" placeholder="Nhập số điện thoại" name="Phone" id="phone" required />
                                    <div class="invalid-feedback">
                                        Vui lòng nhập số điện thoại.
                                    </div>
                                </div>

                                <div class="mb-3 col-6">
                                    <label for="email" class="req">Email</label>
                                    <input type="text" class="form-control" placeholder="Nhập email" name="Email" id="email" required />
                                </div>
                            </div>

                            <div class="row">
                                <div class="mb-3 col-4">
                                    <label for="city" class="req">Thành Phố</label>
                                    <select class="form-control" id="city" name="city" title="Chọn Tỉnh Thành" required>
                                        <option value="0">Tỉnh Thành</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Vui lòng nhập tên Thành Phố:
                                        <br /> - Ví dụ: Hồ Chí Minh, Hà Nội,...
                                    </div>
                                </div>

                                <div class="mb-3 col-4">
                                    <label for="district" class="req">Quận, Huyện</label>
                                    <select class="form-control" id="district" name="district" title="Chọn Quận Huyện" required>
                                        <option value="0">Quận Huyện</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Vui lòng nhập tên Quận, Huyện:
                                        <br /> - Ví dụ: Quận 1, Huyện Bình Chánh,...
                                    </div>
                                </div>

                                <div class="mb-3 col-4">
                                    <label for="ward" class="req">Xã, Phường</label>
                                    <select class="form-control" id="ward" name="ward" title="Chọn Phường Xã">
                                        <option value="0">Phường Xã</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Vui lòng nhập tên Xã, Phường:
                                        <br /> - Ví dụ: Phường Phạm Ngũ Lão, Xã Bình Mỹ,...
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="addressDetaills" class="req">Địa chỉ cụ thể</label>
                                <input type="text" class="form-control" placeholder="Số nhà - Tên Đường" id="addressDetaills" onfocusout="myFunction()" required  />
                                <div class="invalid-feedback">
                                    Vui lòng nhập địa chỉ cụ thể:
                                    <br/> - (Số nhà  - Tên Đường)
                                    <br/> - Tên địa danh (Thôn - Ấp - Làng,...)
                                </div>
                            </div>
                            
                            <input type="text" class="form-control" placeholder="Nhập địa chỉ" name="AddressLine" id="addressLine" hidden />

                            <div class="mb-3">
                                <label for="remarks">Ghi chú</label>
                                <textarea class="form-control" placeholder="Nhập ghi chú" name="Remarks" id="remarks" rows="3"></textarea>
                            </div>
                            <input type="text" class="form-control" value="1" id="paymentMethod" name="PaymentMethod" hidden />
                            <div class="title-cart">Thông tin thanh toán <span>Vui lòng chọn một hình thức thanh toán.</span></div>
                            <div class="info-payment">
                                <a href="javascript:void(0)" class="btn btn-payment active" data-payment="payoo">Payoo</a>
                                <a href="javascript:void(0)" class="btn btn-payment" data-payment="cod">Thanh toán khi nhận hàng</a>
                                <hr class="hr-payment" />
                                <div class="payment-content transfer active">
                                    <p>
                                        <strong>
                                            Vui lòng thanh toán đơn hàng qua cổng thanh toán Payoo. <br/>
                                            Đơn hàng của bạn sẽ được gửi đến bạn trong thời gian sớm nhất!
                                        </strong>
                                    </p>
                                </div>

                                <div class="payment-content cod">
                                    <p><strong>Đơn hàng sẽ được gửi đến bạn trong thời gian sớm nhất!</strong></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="cart-wrapper">
                        <div class="title-cart">Đơn hàng</div>
                        <hr class="hr-payment" />
                        <div id="cartWrapperItem"></div>
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" value="" id="flexCheckChecked" required>
                        <label class="form-check-label req" for="flexCheckChecked">
                            Tôi đã đọc và đồng ý với các <a class="text-decoration-underline" href="/common/policydetails">Chính sách và điều khoản</a> của doctorloan.vn
                        </label>
                        <div class="invalid-feedback">
                            Vui lòng chấp nhận thỏa thuận!
                        </div>
                    </div>
                    <div class="text-center">
                        <button id="btnPayment" class="btn checkout" type="submit">Đặt hàng</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section scripts{
    <script src="https://esgoo.net/scripts/jquery.js"></script>
    <script src="~/libs/jquery/crypto-js.min.js"></script>
    <script type="text/javascript">

        //Lấy tỉnh thành
        $.getJSON('https://esgoo.net/api-tinhthanh/1/0.htm', function (data_tinh) {
            if (data_tinh.error == 0) {
                $.each(data_tinh.data, function (key_tinh, val_tinh) {
                    $("#city").append('<option value="' + val_tinh.id + '">' + val_tinh.full_name + '</option>');
                });
                $("#city").change(function (e) {
                    var idtinh = $(this).val();
                    //Lấy quận huyện
                    $.getJSON('https://esgoo.net/api-tinhthanh/2/' + idtinh + '.htm', function (data_quan) {
                        if (data_quan.error == 0) {
                            $("#district").html('<option value="0">Quận Huyện</option>');
                            $("#ward").html('<option value="0">Phường Xã</option>');
                            $.each(data_quan.data, function (key_quan, val_quan) {
                                $("#district").append('<option value="' + val_quan.id + '">' + val_quan.full_name + '</option>');
                            });
                            //Lấy phường xã
                            $("#district").change(function (e) {
                                var idquan = $(this).val();
                                $.getJSON('https://esgoo.net/api-tinhthanh/3/' + idquan + '.htm', function (data_phuong) {
                                    if (data_phuong.error == 0) {
                                        $("#ward").html('<option value="0">Phường Xã</option>');
                                        $.each(data_phuong.data, function (key_phuong, val_phuong) {
                                            $("#ward").append('<option value="' + val_phuong.id + '">' + val_phuong.full_name + '</option>');
                                        });
                                    }
                                });
                            });

                        }
                    });

                    $(".btn-payment").trigger('click');
                });

            }
        });

        //Function get data address
        function myFunction() {
            return $("#addressLine").val($("#addressDetaills").val() + " - " + $("#ward :selected").text() + " - " + $("#district :selected").text() + " - " + $("#city :selected").text());
        }

        //Function select method payment
        $(document).on('click', '.btn-payment', function () {
            $('.btn-payment').removeClass("active");
            $(this).addClass("active");
            var getdatapayment = $(this).attr("data-payment");
            $('.payment-content').removeClass("active");
            $('.payment-content.' + getdatapayment).addClass("active");

            if (getdatapayment == 'transfer') {
                $('#paymentMethod').val('1');
            } 
            
            if (getdatapayment == 'cod') {
                $('#paymentMethod').val('2');
            } 

            if (getdatapayment == 'payoo') {
                $('#paymentMethod').val('3');
            }
        });

        //Function convert formart VND
        function formartVND(e) {
            e.text(parseInt(e.text()).toLocaleString('vi', { style: 'currency', currency: 'VND' }));
        }

        //Handel change quantity element
        function changeQuantity(e, data) {
            e.change(function () {
                var _price = data.data.price;
                var _subTotal = data.data.price * e.val();
                var _currency = Number($("#cartSubtotal").text().replace(/[^0-9,-]/g, ''));
                $("#cartSubtotal").html(_subTotal);

                formartVND($("#cartSubtotal"));

                var _total = _subTotal + data.data.priceDiscount;
                $("#cartTotal").html(_total);
                formartVND($('#cartTotal'));
            });
        }

        //Function get parameter in url
        function getParameterByName(name, url) {
            if (!url) url = window.location.href;
            name = name.replace(/[\[\]]/g, '\\$&');
            var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
                results = regex.exec(url);
            if (!results) return null;
            if (!results[2]) return '';
            return decodeURIComponent(results[2].replace(/\+/g, ' '));
        }

        //handle calculate price
        function calculatePrice(_sku, _quantity, data) {
            var _price = 0;
            if (data.sku == _sku) {
                _price = data.price;
            } else {
                $.each(data.productItems, function (idx, item) {
                    if (item.sku === _sku) {
                        _price = item.price;
                    }
                });
            } 

            if (_price != 0) {
                var _subTotal = _price * _quantity;
                $("#cart-subtotal").html(_subTotal);
                formartVND($("#cart-subtotal"));

                var _total = _subTotal + data.priceDiscount;
                $("#cart-total").html(_total);
                formartVND($('#cart-total'));
            }
            
        }

        //handle pic product to color
        function loadProductForColor(productItem, data, element) {
            var _arr = [];
            var _codeColor;

            $.each(data.productItems, function (idx, item) {
                if (item.name == productItem) {
                    _codeColor = item.sku;
                }
            });

            $.each(data.productMedias, function (idx, item) {
                if (item.itemCode == _codeColor) {
                    _arr.push(item);
                }
            });

            if (_arr[0] != undefined) {
                $("#imgProductPayment").attr('src', _arr[0].mediaUrl);
            }

            $(".product-color").removeClass("active");
            element.addClass("active");
        }

        //handle get Product id for color
        function getOptionProductForColor(option, data) {
            var productId = data.id;
            $.each(data.productItems, function (idx, item) {
                if (item.sku === option) {
                    $("#productItemId-" + productId).val(item.id);
                }
            });
        }

        //handle get Product id for option
        function getOptionProductForOption(option, data) {
            $.each(data.productItems, function (idx, item) {
                if (item.name === option) {
                    $("#productItemId-" + data.id).val(item.id);
                    $('#iprPrice').text(item.price);

                    calculatePrice(item.sku, $('#quantityPayment-' + data.id).val(), data);
                }
            });
            $('#iprPrice').text(parseInt($('#iprPrice').text()).toLocaleString('vi', { style: 'currency', currency: 'VND' }));
        }

        var resultAPI;
        var _productId = 0;
        var _quantity = 0;

        if (getParameterByName('id') && getParameterByName('quantity')) {
            _productId = getParameterByName('id');
            _quantity = getParameterByName('quantity');
        } else {
            _productId = $('#idProduct').val();
            _quantity = $('#qProduct').val();
        }

        if (_productId == undefined || _quantity == undefined || _productId == 0 || _quantity == 0) {
            window.location.href = "/";
        }

        // Get the value of the parameter productId in URL
        $.ajax({
            url: 'https://doctorloan-api.giathaidoctorloan.vn/api/product-module/Product/GetProduct?id=' +_productId,
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                resultAPI = data;
                var productId = data.data.id;
                // Handle call API Products
                var productItem = $(`<div data-id="` + productId + `" class="list-product-payment">
                                                <input type="text" class="form-control" value="`+ _productId + `" name="ProductId" hidden />
                                                <div class="pp-item">
                                                    <div class="pp-info">
                                                        <img id="imgProductPayment" style="width:60px; height: 60px;" src="`+ data.data.productMedias[0].mediaUrl + `" />
                                                        <div id="pp-desc" class="pp-desc">
                                                        <strong>`+ data.data.name + `</strong>
                                                        <input type="text" name="Name" value="`+ data.data.name + `" class="form-control" hidden />
                                                        <div style="display:left;" >
                                                            <div id="quantity">
                                                                <label for="quantityPayment-`+ productId + `">Số Lượng</label>
                                                                <input min="1" type="number" name="Quantity" value="`+ _quantity + `" id="quantityPayment-` + productId + `" class="form-control" style="width: 80px !important" />
                                                            </div>
                                                            <div id="paymentItemColor" class="ipr-color"></div>
                                                            <div id="iprItemOption" class="ipr-item">
                                                                <input type="number" name="ProductItemId" value="`+ data.data.productItems[0].id + `" id="productItemId-` + data.data.id + `" hidden />
                                                            </div>
                                                        </div>
                                                        </div>
                                                    </div>
                                                    <div id="iprPrice">`+ data.data.price + `</div>
                                                    <input type="text" name="Price" value="`+ data.data.price + `" class="form-control" hidden />
                                                </div>
                                            </div>
                                            <div class="total-cart">
                                                <div class="total-info">
                                                    <span>Tạm tính</span>
                                                    <span id="cart-subtotal">`+ data.data.price + `</span>
                                                </div>
                                                <div class="total-info">
                                                    <span>Phí vận chuyển</span>
                                                    <span id="cart-shipping">Miễn phí toàn quốc</span>
                                                </div>
                                                <div class="total-info totals-item-total">
                                                    <span>Tổng cộng</span>
                                                    <span id="cart-total">`+ (data.data.price + data.data.priceDiscount) + `</span>
                                                    <input type="text" name="TotalPrice" value="`+ (data.data.price + data.data.priceDiscount) + `" class="form-control" hidden />
                                                </div>
                                            </div>`);
                $("#cartWrapperItem").append(productItem);

                formartVND($('#iprPrice'));
                formartVND($('#cart-subtotal'));
                formartVND($('#cart-total'));

                var imgProduct = "";
                var imgThumb = "";
                var _sku135 = "LC35LESY";
                var _sku90 = "SC90DESY";
                var _sku90T = "SC90TESY";
                var _sku95 = "SC95VESY";
                var _skuN85 = "PL85SFOR";
                var _skuF4 = "NP04SEFY";
                var _skuF5 = "NP05SEFY";
                var _skuF6 = "NP06SEFY";
                var _skuF3 = "BP03CEFY";
                var _skuF1 = "BP01LEFY";
                var _skuDT = "SDNLSESY";
                var _skuGCSS = "NP00OEFY";
                var _skuGC26 = "NP26SEFY";
                var _skuGC61 = "NP61SEFY";
                var _skuGC = "NP00SEFY";
                var _skuGCNL = "NPAUNEFY";
                var _skuGCDL = "NPTLSEFY";
                var _skuGCDX = "NPCROEFY";

                if (data.data.productItems[0].productOptions != undefined && data.data.productItems[0].productOptions[0] != undefined) {
                    var _arr = [];
                    if (data.data.sku === _skuDT) {
                        $("#iprItemOption").append(`<label>.Tuỳ chọn</label>
                                                    <div class="form-check">
                                                        <input class="form-check-input product-option option-dt" type="radio" name="flexRadioOption" data-option="`+ data.data.name + `/M" id="dtL" >
                                                        <label class="form-check-label" for="dtL">Lớn</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input product-option option-dt" type="radio" name="flexRadioOption" data-option="`+ data.data.name + `/S" id="dtS" checked>
                                                        <label class="form-check-label" for="dtS">Nhỏ</label>
                                                    </div>`);
                    }

                    if (data.data.sku === _skuF4) {
                        $("#iprItemOption").append(`<label>.Tuỳ chọn</label>
                                                    <div class="form-check">
                                                        <input class="form-check-input product-option option-f4" type="radio" name="flexRadioOption" data-option="`+ data.data.name + `/12" id="f4L">
                                                            <label class="form-check-label" for="f4L">12 cm</label>
                                                        </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input product-option option-f4" type="radio" name="flexRadioOption" data-option="`+ data.data.name + `/09" id="f4S" checked>
                                                        <label class="form-check-label" for="f4S">9 cm</label>
                                                    </div>`);
                    }

                    if (data.data.sku === _skuF1) {
                        $("#iprItemOption").append(`<label>.Tuỳ chọn</label>
                                                    <div class="form-check">
                                                        <input class="form-check-input product-option option-f1" type="radio" name="flexRadioOption" data-option="`+ data.data.name + `/L" id="f1L" >
                                                        <label class="form-check-label" for="f1L">Dài</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input product-option option-f1" type="radio" name="flexRadioOption" data-option="`+ data.data.name + `/S" id="f1S" checked>
                                                        <label class="form-check-label" for="f1S">Ngắn</label>
                                                    </div>`);
                    }

                    if (data.data.sku === _sku135 || data.data.sku === _sku95 || data.data.sku === _sku90 || data.data.sku === _sku90T) {
                        $("#paymentItemColor").append(`<label>.Màu sắc</label>
                                                        <div class="ipr-color">
                                                            <a href="javascript:void(0)" class="product-color brown active" data-color="`+ data.data.name + `/Y" title="Màu nâu"></a>
                                                            <a href="javascript:void(0)" class="product-color grape" data-color="`+ data.data.name + `/P" title="Màu nho"></a>
                                                            <a href="javascript:void(0)" class="product-color black" data-color="`+ data.data.name + `/B" title="Màu đen"></a>
                                                            <a href="javascript:void(0)" class="product-color green" data-color="`+ data.data.name + `/G" title="Màu xanh"></a>
                                                        </div>`);
                    }

                    if (data.data.sku === _skuN85) {
                        $("#paymentItemColor").append(`<label>.Màu sắc</label>
                                                        <div class="ipr-color">
                                                            <a href="javascript:void(0)" class="product-color yellow active" data-color="/YL" title="Màu vàng"></a>
                                                            <a href="javascript:void(0)" class="product-color orange" data-color="/OR" title="Màu cam"></a>
                                                            <a href="javascript:void(0)" class="product-color red" data-color="/RE" title="Màu đỏ"></a>
                                                            <a href="javascript:void(0)" class="product-color gray" data-color="/GE" title="Màu xám"></a>
                                                            <a href="javascript:void(0)" class="product-color green" data-color="/GR" title="Màu xanh lá"></a>
                                                            <a href="javascript:void(0)" class="product-color blue" data-color="/BL" title="Màu xanh dương"></a>
                                                        </div>`);
                        $("#iprItemOption").append(`<label>.Tuỳ chọn</label>
                                                    <div class="form-check">
                                                        <input class="form-check-input product-option option-n85" type="radio" name="flexRadioOption" data-option="-L" value="Chân dài" id="n85-L">
                                                        <label class="form-check-label" for="n85-L">Chân dài</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input product-option option-n85" type="radio" name="flexRadioOption" data-option="-S" value="Chân ngắn" id="n85-S" checked>
                                                        <label class="form-check-label" for="n85-S">Chân ngắn</label>
                                                    </div>`);
                    }
                }

                if (data.data.sku != _skuN85) {
                    // Handle click event for color
                    $('.product-color').click(function () {
                        var getcolor = $(this).attr("data-color");
                        loadProductForColor(getcolor, data.data);
                    });

                    var _flagSku;
                    // Handle click event for option
                    $('.product-option').click(function () {
                        var option = $(this).attr("data-option");
                        $.each(data.data.productItems, function (idx, item) {
                            if (item.name === option) {
                                _flagSku = item.sku;
                            }
                        });
                        getOptionProductForOption(option, data.data);
                    });

                    if (data.data.sku != _skuF1 || data.data.sku != _skuDT || data.data.sku != _skuF4) {
                        $('#quantityPayment-' + productId).change(function () {
                            calculatePrice(data.data.sku, $('#quantityPayment-' + productId).val(), data.data);
                        });
                    } else {
                        $('#quantityPayment-' + productId).change(function () {
                            $('.product-option').trigger("click");
                            calculatePrice(data.data.sku, $('#quantityPayment-' + productId).val(), data.data);
                        });
                    }
                } else {
                    // Handle click event for color
                    $('.product-color').click(function () {
                        var _option = $('.product-option:checked').attr("data-option");
                        var getcolor = data.data.name + _option + $(this).attr("data-color");
                        loadProductForColor(getcolor, data.data, $(this));
                    });

                    var _flagSku;
                    // Handle click event for option
                    $('.product-option').click(function () {
                        var _color = $('.product-color.active').attr("data-color");
                        var option = data.data.name + $(this).attr("data-option") + _color;
                        $.each(data.data.productItems, function (idx, item) {
                            if (item.name === option) {
                                _flagSku = item.sku;
                            }
                        });
                        getOptionProductForOption(option, data.data);
                    });
                    // Handle change quantity
                    var _flagSkus;
                    $('#quantityPayment-' + productId).change(function () {
                        var _option = $('.product-option:checked').attr("data-option");
                        var _color = $('.product-color.active').attr("data-color");
                        var _sku = data.data.name + _option + _color;
                        $.each(data.data.productItems, function (idx, item) {
                            if (item.sku === _sku) {
                                _flagSkus = item.sku;
                            }
                        });
                        calculatePrice(_flagSku, $('#quantityPayment-' + productId).val(), data.data);
                    });
                }
            },
            error: function (error) {
                //handle show error
                console.error('Error:', error);
            }
        });

        //handle show alert
        window.setTimeout(function () {
            $(".alert").fadeTo(500, 0).slideUp(500, function () {
                $(this).remove();
            });
        }, 3000);

        //Validation
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);

            })
        })();

        // Handle redirect to Url with data
        function redirectToWithData(url, data) {
            // Create query parameters obj data
            var queryParams = $.param(data);

            // Handle string query parameters in URL
            var redirectUrl = queryParams ? url + "?" + queryParams : url;

            // Redirect to Url
            window.location.href = redirectUrl;
        }
    </script>
}