                                                                <a href="javascript:void(0)" class="product-color red" data-color="`+ data.data.sku + `-MAU DO" title="Màu đỏ"></a>
                                                                <a href="javascript:void(0)" class="product-color gray" data-color="`+ data.data.sku + `-MAU XAM" title="Màu xám"></a>
                                                                <a href="javascript:void(0)" class="product-color green" data-color="`+ data.data.sku + `-MAU XANH LA" title="Màu xanh lá"></a>
                                                                <a href="javascript:void(0)" class="product-color blue" data-color="`+ data.data.sku + `-MAU XANH DUONG" title="Màu xanh dương"></a>
                                                            </div>`);
                                $("#iprItemOption").append(`<label>.Tuỳ chọn</label>
                                                            <div class="form-check">
