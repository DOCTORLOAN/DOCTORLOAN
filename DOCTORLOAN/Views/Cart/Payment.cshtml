                                                                <label class="form-check-label" for="n85-L">Chân dài</label>
                                                            </div>
                                                            <div class="form-check">
                                                                <input class="form-check-input option-n85" type="radio" name="flexRadioOption" data-option="-CHAN NGAN" value="Chân ngắn" id="n85-S" checked>
                                                                <label class="form-check-label" for="n85-S">Chân ngắn</label>
                                                            </div>`);
                                $('.option-n85').click(function () {
                                    if ($('#n85-L').is(':checked')) {
                                        var option = $(".product-color").attr("data-color") + $(this).attr("data-option");
                                        getOptionProductForOption(option);
                                        $('.product-color').trigger("click");
                                    } else {
                                        var option = $(".product-color").attr("data-color") + $(this).attr("data-option");
                                        getOptionProductForOption(option);
                                        $('.product-color').trigger("click");
                                    }
                                });

                                $('.product-color').click(function () {
                                    var getcolor = $(this).attr("data-color") + $(".option-n85").attr("data-option");
                                    loadProductForColor(getcolor);
                                });
                            }
                        }

                        $.each(data.data.productMedias, function (_idx, _item) {
                            if (flagN85 != true) {
                                if (_item.itemCode == data.data.sku + '-MAU NAU') {
                                    _arr.push(_item);
