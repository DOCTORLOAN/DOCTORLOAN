@model DOCTORLOAN.Models.Orders.PaymentViewModel
@using DOCTORLOAN.Models.Orders;
@{
    ViewData["Title"] = "Thanh Toán";
}

@await Html.PartialAsync("_LoadingState")
<section id="CartPayment" class="cart-payment">
    <div class="container">
        <div class="row">
            <form id="CartPaymentForm" method="post" asp-controller="Cart" asp-action="PaymentPost" class="row needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <div id="alert" class="alert alert-error">
                    @if (TempData["AlertMessageError"] != null)
                    {
                        <div class="alert alert-warning">
                            @TempData["AlertMessageError"]
                        </div>
                    }
                   
                </div>
                 @if (TempData["AlertMessageError"] != null)
                {
                    <input type="text" class="form-control" value="@TempData["id"]" id="idProduct" hidden />
                    <input type="text" class="form-control" value="@TempData["quantity"]" id="qProduct" hidden />
                }
                <div class="col-lg-7">
                    <div class="cart-wrapper">
                        <div class="title-cart">Thông tin đơn hàng</div>
                        <div class="cart-link">Đã có tài khoản?&nbsp; <a asp-controller="Auth" asp-action="Login">Đăng nhập</a></div>
                        <div class="cart-form">
                            <div class="mb-3">
                                <label for="fullName" class="req">Tên người nhận</label>
                                <input type="text" class="form-control" placeholder="Nhập tên người nhận" name="FullName" id="fullName" required />
                                <div class="invalid-feedback">
                                    Vui lòng nhập họ tên.
                                </div>
                            </div>

                            <div class="row">
                                <div class="mb-3 col-6">
                                    <label for="phone" class="req">Số điện thoại</label>
                                    <input type="tel" class="form-control" placeholder="Nhập số điện thoại" name="Phone" id="phone" required pattern="^(0[0-9]{9,10})$" inputmode="numeric" />
                                    <div class="invalid-feedback">
                                        Vui lòng nhập số điện thoại hợp lệ (10-11 số và bắt đầu bằng 0).
                                    </div>
                                </div>

                                <div class="mb-3 col-6">
                                    <label for="email" class="req">Email</label>
                                    <input type="email" class="form-control" placeholder="Nhập email" name="Email" id="email" />
                                    <div class="invalid-feedback">
                                        Vui lòng nhập email hợp lệ.
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="mb-3 col-4">
                                    <label for="city" class="req">Thành Phố</label>
                                    <select class="form-control" id="city" name="city" title="Chọn Tỉnh Thành" required>
                                        <option value="" selected disabled>Tỉnh Thành</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Vui lòng nhập tên Thành Phố:
                                        <br /> - Ví dụ: Hồ Chí Minh, Hà Nội,...
                                    </div>
                                </div>

                                <div class="mb-3 col-4">
                                    <label for="district" class="req">Quận, Huyện</label>
                                    <select class="form-control" id="district" name="district" title="Chọn Quận Huyện" required>
                                        <option value="" selected disabled>Quận Huyện</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Vui lòng nhập tên Quận, Huyện:
                                        <br /> - Ví dụ: Quận 1, Huyện Bình Chánh,...
                                    </div>
                                </div>

                                <div class="mb-3 col-4">
                                    <label for="ward" class="req">Xã, Phường</label>
                                    <select class="form-control" id="ward" name="ward" title="Chọn Phường Xã" required>
                                        <option value="" selected disabled>Phường Xã</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Vui lòng nhập tên Xã, Phường:
                                        <br /> - Ví dụ: Phường Phạm Ngũ Lão, Xã Bình Mỹ,...
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="addressDetaills" class="req">Địa chỉ cụ thể</label>
                                <input type="text" class="form-control" placeholder="Số nhà - Tên Đường" id="addressDetaills" required />
                                <div class="invalid-feedback">
                                    Vui lòng nhập địa chỉ cụ thể:
                                    <br/> - (Số nhà  - Tên Đường)
                                    <br/> - Tên địa danh (Thôn - Ấp - Làng,...)
                                </div>
                            </div>
                            
                            <input type="text" class="form-control" placeholder="Nhập địa chỉ" name="AddressLine" id="addressLine" hidden />

                            <div class="mb-3">
                                <label for="remarks">Ghi chú</label>
                                <textarea class="form-control" placeholder="Nhập ghi chú" name="Remarks" id="remarks" rows="3"></textarea>
                            </div>
                            <input type="text" class="form-control" value="3" id="paymentMethod" name="PaymentMethod" hidden />
                            @*<div class="title-cart">Thông tin thanh toán <span>Vui lòng chọn một hình thức thanh toán.</span></div>
                            <div class="info-payment">
                                <a href="javascript:void(0)" class="btn btn-payment active" data-payment="payoo">Payoo</a>
                                <a href="javascript:void(0)" class="btn btn-payment" data-payment="cod">Thanh toán khi nhận hàng</a>
                                <hr class="hr-payment" />
                                <div class="payment-content transfer active">
                                    <p>
                                        <strong>
                                            Vui lòng thanh toán đơn hàng qua cổng thanh toán Payoo. <br/>
                                            Đơn hàng của bạn sẽ được gửi đến bạn trong thời gian sớm nhất!
                                        </strong>
                                    </p>
                                </div>

                                <div class="payment-content cod">
                                    <p><strong>Đơn hàng sẽ được gửi đến bạn trong thời gian sớm nhất!</strong></p>
                                </div>
                            </div>*@
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="cart-wrapper">
                        <div class="title-cart">Đơn hàng</div>
                        <hr class="hr-payment" />
                        <div id="cartWrapperItem">
                            @if (Model?.Product != null)
                            {
                                var product = Model.Product;
                                var defaultImage = product.ProductMedias?.FirstOrDefault()?.MediaUrl ?? product.ImageUrl;
                                var defaultProductItem = product.ProductItems?.FirstOrDefault();
                                var productItemId = defaultProductItem?.Id ?? 0;
                                var price = defaultProductItem?.Price ?? product.Price;
                                
                                <div data-id="@product.Id" class="list-product-payment">
                                    <input type="text" class="form-control" value="@Model.ProductId" name="ProductId" hidden />
                                    <div class="pp-item">
                                        <div class="pp-info">
                                            <img loading="lazy" id="imgProductPayment" style="width:60px; height: 60px;" src="@defaultImage" alt="@product.Name" />
                                            <div id="pp-desc" class="pp-desc">
                                                <strong>@product.Name</strong>
                                                <input type="text" name="Name" value="@product.Name" class="form-control" hidden />
                                                <div style="display:left;">
                                                    <div id="quantity">
                                                        <label for="quantityPayment-@product.Id">Số Lượng</label>
                                                        <input min="1" type="number" name="Quantity" value="@Model.Quantity" id="quantityPayment-@product.Id" class="form-control" style="width: 80px !important" />
                                                    </div>
                                                    <div id="paymentItemColor" class="ipr-color"></div>
                                                    <div id="iprItemOption" class="ipr-item">
                                                        <input type="number" name="ProductItemId" value="@productItemId" id="productItemId-@product.Id" hidden />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="iprPrice">@price.ToString("N0")</div>
                                        <input type="text" name="Price" value="@price" class="form-control" hidden />
                                    </div>
                                </div>
                                <div class="total-cart">
                                    <div class="total-info">
                                        <span>Tạm tính</span>
                                        <span id="cart-subtotal">@Model.SubTotal.ToString("N0")</span>
                                    </div>
                                    <div class="total-info">
                                        <span>Phí vận chuyển</span>
                                        <span id="cart-shipping">Miễn phí toàn quốc</span>
                                    </div>
                                    <div class="total-info totals-item-total">
                                        <span>Tổng cộng</span>
                                        <span id="cart-total">@Model.TotalPrice.ToString("N0")</span>
                                        <input type="text" name="TotalPrice" value="@Model.TotalPrice" class="form-control" hidden />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" value="" id="flexCheckChecked" required>
                        <label class="form-check-label req" for="flexCheckChecked">
                            Tôi đã đọc và đồng ý với các <a class="text-decoration-underline" href="/common/policydetails">Chính sách và điều khoản</a> của doctorloan.vn
                        </label>
                        <div class="invalid-feedback">
                            Vui lòng chấp nhận thỏa thuận!
                        </div>
                    </div>
                    <div class="text-center">
                        <button id="btnPayment" class="btn checkout" type="submit">Đặt hàng</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section scripts{
    <script src="~/auth/jquery-3.3.1.min.js"></script>
    <script src="~/libs/jquery/crypto-js.min.js"></script>
    <script type="text/javascript">

        const form = document.getElementById('CartPaymentForm');
        const phoneInput = document.getElementById('phone');
        const emailInput = document.getElementById('email');
        const citySelect = document.getElementById('city');
        const districtSelect = document.getElementById('district');
        const wardSelect = document.getElementById('ward');
        const addressDetailsInput = document.getElementById('addressDetaills');
        const addressLineInput = document.getElementById('addressLine');
        const termsCheckbox = document.getElementById('flexCheckChecked');
        const phoneRegex = /^(0\d{9,10})$/;

        function updateAddressLine() {
            if (!addressLineInput) return;

            const parts = [
                addressDetailsInput?.value.trim() ?? '',
                wardSelect && wardSelect.selectedIndex > 0 ? wardSelect.options[wardSelect.selectedIndex].text : '',
                districtSelect && districtSelect.selectedIndex > 0 ? districtSelect.options[districtSelect.selectedIndex].text : '',
                citySelect && citySelect.selectedIndex > 0 ? citySelect.options[citySelect.selectedIndex].text : ''
            ].filter(part => part && part !== 'Phường Xã' && part !== 'Quận Huyện' && part !== 'Tỉnh Thành');

            addressLineInput.value = parts.join(' - ');
        }

        if (addressDetailsInput) {
            addressDetailsInput.addEventListener('input', () => {
                if (addressDetailsInput.value.trim()) {
                    addressDetailsInput.setCustomValidity('');
                }
                updateAddressLine();
            });
        }

        [citySelect, districtSelect, wardSelect].forEach(select => {
            if (!select) {
                return;
            }

            select.addEventListener('change', () => {
                if (select.value) {
                    select.setCustomValidity('');
                } else {
                    select.setCustomValidity('Trường này là bắt buộc.');
                }
                updateAddressLine();
            });
        });

        if (phoneInput) {
            phoneInput.addEventListener('input', () => {
                phoneInput.value = phoneInput.value.replace(/\D/g, '');
                if (phoneRegex.test(phoneInput.value.trim())) {
                    phoneInput.setCustomValidity('');
                }
            });
        }

        if (emailInput) {
            emailInput.addEventListener('input', () => {
                emailInput.value = emailInput.value.trim();
                if (!emailInput.value || emailInput.checkValidity()) {
                    emailInput.setCustomValidity('');
                }
            });
        }

        if (termsCheckbox) {
            termsCheckbox.addEventListener('change', () => {
                if (termsCheckbox.checked) {
                    termsCheckbox.setCustomValidity('');
                }
            });
        }

        function validateQuantities() {
            let isValid = true;
            const qtyInputs = document.querySelectorAll('input[name="Quantity"]');
            qtyInputs.forEach((inp) => {
                const value = parseInt((inp.value || '').toString().trim(), 10);
                if (!Number.isInteger(value) || value < 1 || value > 1000) {
                    inp.setCustomValidity('Số lượng phải từ 1 đến 1000.');
                    isValid = false;
                } else {
                    inp.setCustomValidity('');
                }
            });
            return isValid;
        }

        document.addEventListener('input', (e) => {
            const target = e.target;
            if (target && target.getAttribute('name') === 'Quantity') {
                const value = target.value.replace(/\D/g, '');
                target.value = value;
                if (value) {
                    target.setCustomValidity('');
                }
            }
        });

        // Helper: hiển thị tổng hợp lỗi ngắn gọn
        function showErrorSummary() {
            const alertBox = document.getElementById('alert');
            if (!alertBox) return;
            // chỉ hiển thị nếu có phần tử invalid
            const firstInvalid = form?.querySelector('.form-control:invalid, .form-check-input:invalid, select:invalid');
            if (firstInvalid) {
                alertBox.innerHTML = '<div class="alert alert-warning">Vui lòng kiểm tra lại các trường được yêu cầu.</div>';
            }
        }

        // Realtime: toggle is-valid/is-invalid
        document.addEventListener('input', function (e) {
            var el = e.target;
            if (!(el instanceof HTMLElement)) return;
            if (el.matches('.form-control, .form-check-input, select')) {
                var inputElement = el;
                if (inputElement.checkValidity()) {
                    el.classList.remove('is-invalid');
                    el.classList.add('is-valid');
                } else {
                    el.classList.remove('is-valid');
                    // chỉ thêm is-invalid khi người dùng đã tương tác
                }
            }
        });

        if (form) {
            form.addEventListener('submit', (event) => {
                const submitBtn = document.getElementById('btnPayment');
                let originalBtnHtml = '';
                if (submitBtn) {
                    originalBtnHtml = submitBtn.innerHTML;
                    submitBtn.disabled = true;
                    submitBtn.classList.add('disabled');
                    submitBtn.setAttribute('aria-busy', 'true');
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...';
                }
                if (phoneInput) {
                    phoneInput.value = phoneInput.value.trim();
                    if (!phoneRegex.test(phoneInput.value)) {
                        phoneInput.setCustomValidity('Vui lòng nhập số điện thoại hợp lệ (10-11 số và bắt đầu bằng 0).');
                    } else {
                        phoneInput.setCustomValidity('');
                    }
                }

                if (emailInput) {
                    emailInput.value = emailInput.value.trim();
                    if (emailInput.value && !emailInput.checkValidity()) {
                        emailInput.setCustomValidity('Vui lòng nhập email hợp lệ.');
                    } else {
                        emailInput.setCustomValidity('');
                    }
                }

                [citySelect, districtSelect, wardSelect].forEach(select => {
                    if (select && !select.value) {
                        select.setCustomValidity('Trường này là bắt buộc.');
                    }
                });

                if (addressDetailsInput) {
                    addressDetailsInput.value = addressDetailsInput.value.trim();
                    if (!addressDetailsInput.value) {
                        addressDetailsInput.setCustomValidity('Vui lòng nhập địa chỉ cụ thể.');
                    } else {
                        addressDetailsInput.setCustomValidity('');
                    }
                }

                const qtyOk = validateQuantities();
                updateAddressLine();

                if (termsCheckbox && !termsCheckbox.checked) {
                    termsCheckbox.setCustomValidity('Bạn phải đồng ý với điều khoản.');
                }

                if (!form.checkValidity() || !qtyOk) {
                    event.preventDefault();
                    event.stopPropagation();
                    // Scroll tới lỗi đầu tiên
                    const firstInvalid = form.querySelector('.form-control:invalid, .form-check-input:invalid, select:invalid');
                    if (firstInvalid) {
                        const el = firstInvalid;
                        el.classList.add('is-invalid');
                        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        if (typeof el.focus === 'function') {
                            el.focus();
                        }
                    }
                    showErrorSummary();
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('disabled');
                        submitBtn.removeAttribute('aria-busy');
                        submitBtn.innerHTML = originalBtnHtml || 'Đặt hàng';
                    }
                }

                form.classList.add('was-validated');
            }, false);
        }

        //Lấy tỉnh thành
        $.getJSON('https://esgoo.net/api-tinhthanh/1/0.htm', function (data_tinh) {
            if (data_tinh.error == 0) {
                $.each(data_tinh.data, function (key_tinh, val_tinh) {
                    $("#city").append('<option value="' + val_tinh.id + '">' + val_tinh.full_name + '</option>');
                });
                $("#city").change(function (e) {
                    var idtinh = $(this).val();
                    //Lấy quận huyện
                    $.getJSON('https://esgoo.net/api-tinhthanh/2/' + idtinh + '.htm', function (data_quan) {
                        if (data_quan.error == 0) {
                            $("#district").html('<option value="" selected disabled>Quận Huyện</option>');
                            $("#ward").html('<option value="" selected disabled>Phường Xã</option>');
                            $.each(data_quan.data, function (key_quan, val_quan) {
                                $("#district").append('<option value="' + val_quan.id + '">' + val_quan.full_name + '</option>');
                            });
                            //Lấy phường xã
                            $("#district").change(function (e) {
                                var idquan = $(this).val();
                                $.getJSON('https://esgoo.net/api-tinhthanh/3/' + idquan + '.htm', function (data_phuong) {
                                    if (data_phuong.error == 0) {
                                        $("#ward").html('<option value="0">Phường Xã</option>');
                                        $.each(data_phuong.data, function (key_phuong, val_phuong) {
                                            $("#ward").append('<option value="' + val_phuong.id + '">' + val_phuong.full_name + '</option>');
                                        });
                                    }
                                });
                            });

                        }
                    });

                    $(".btn-payment").trigger('click');
                });

            }
        });

        //Function get data address
        function myFunction() {
            return $("#addressLine").val($("#addressDetaills").val() + " - " + $("#ward :selected").text() + " - " + $("#district :selected").text() + " - " + $("#city :selected").text());
        }

        //Function select method payment
        $(document).on('click', '.btn-payment', function () {
            $('.btn-payment').removeClass("active");
            $(this).addClass("active");
            var getdatapayment = $(this).attr("data-payment");
            $('.payment-content').removeClass("active");
            $('.payment-content.' + getdatapayment).addClass("active");

            if (getdatapayment == 'transfer') {
                $('#paymentMethod').val('1');
            } 
            
            if (getdatapayment == 'cod') {
                $('#paymentMethod').val('2');
            } 

            if (getdatapayment == 'payoo') {
                $('#paymentMethod').val('3');
            }
        });

        //Function convert formart VND
        function formartVND(e) {
            e.text(parseInt(e.text()).toLocaleString('vi', { style: 'currency', currency: 'VND' }));
        }

        //Handel change quantity element
        function changeQuantity(e, data) {
            e.change(function () {
                var _price = data.data.price;
                var _subTotal = data.data.price * e.val();
                var _currency = Number($("#cartSubtotal").text().replace(/[^0-9,-]/g, ''));
                $("#cartSubtotal").html(_subTotal);

                formartVND($("#cartSubtotal"));

                var _total = _subTotal + data.data.priceDiscount;
                $("#cartTotal").html(_total);
                formartVND($('#cartTotal'));
            });
        }

        //Function get parameter in url
        function getParameterByName(name, url) {
            if (!url) url = window.location.href;
            name = name.replace(/[\[\]]/g, '\\$&');
            var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
                results = regex.exec(url);
            if (!results) return null;
            if (!results[2]) return '';
            return decodeURIComponent(results[2].replace(/\+/g, ' '));
        }

        //handle calculate price
        function calculatePrice(_sku, _quantity, data) {
            var _price = 0;
            if (data.sku == _sku) {
                _price = data.price;
            } else {
                $.each(data.productItems, function (idx, item) {
                    if (item.sku === _sku) {
                        _price = item.price;
                    }
                });
            } 

            if (_price != 0) {
                var _subTotal = _price * _quantity;
                $("#cart-subtotal").html(_subTotal);
                formartVND($("#cart-subtotal"));

                var _total = _subTotal + data.priceDiscount;
                $("#cart-total").html(_total);
                formartVND($('#cart-total'));
            }
            
        }

        //handle pic product to color
        function loadProductForColor(productItem, data, element) {
            var _arr = [];
            var _codeColor;

            $.each(data.productItems, function (idx, item) {
                if (item.name == productItem) {
                    _codeColor = item.sku;
                }
            });

            $.each(data.productMedias, function (idx, item) {
                if (item.itemCode == _codeColor) {
                    _arr.push(item);
                }
            });

            if (_arr[0] != undefined) {
                $("#imgProductPayment").attr('src', _arr[0].mediaUrl);
            }

            $(".product-color").removeClass("active");
            element.addClass("active");
        }

        //handle get Product id for color
        function getOptionProductForColor(option, data) {
            var productId = data.id;
            $.each(data.productItems, function (idx, item) {
                if (item.sku === option) {
                    $("#productItemId-" + productId).val(item.id);
                }
            });
        }

        //handle get Product id for option
        function getOptionProductForOption(option, data) {
            $.each(data.productItems, function (idx, item) {
                if (item.name === option) {
                    $("#productItemId-" + data.id).val(item.id);
                    $('#iprPrice').text(item.price);

                    calculatePrice(item.sku, $('#quantityPayment-' + data.id).val(), data);
                }
            });
            $('#iprPrice').text(parseInt($('#iprPrice').text()).toLocaleString('vi', { style: 'currency', currency: 'VND' }));
        }

        @if (Model?.Product != null)
        {
            <text>
            var resultAPI = @Html.Raw(Json.Serialize(new { data = new { 
                id = Model.Product.Id,
                name = Model.Product.Name,
                sku = Model.Product.Sku,
                price = Model.Product.Price,
                priceDiscount = Model.Product.ProductDetails?.FirstOrDefault() != null ? 0 : 0, // Add priceDiscount if available
                productMedias = Model.Product.ProductMedias?.Select(pm => new { mediaUrl = pm.MediaUrl, itemCode = pm.ItemCode }),
                productItems = Model.Product.ProductItems?.Select(pi => new { 
                    id = pi.Id, 
                    name = pi.Name, 
                    sku = pi.Sku, 
                    price = pi.Price 
                })
            }}));
            var productId = @Model.Product.Id;
            var _quantity = @Model.Quantity;

            // Format currency on page load
            $(document).ready(function() {
                formartVND($('#iprPrice'));
                formartVND($('#cart-subtotal'));
                formartVND($('#cart-total'));
            });

            var _sku135 = "LC35LESY";
            var _sku90 = "SC90DESY";
            var _sku90T = "SC90TESY";
            var _sku95 = "SC95VESY";
            var _skuN85 = "PL85SFOR";
            var _skuF4 = "NP04SEFY";
            var _skuF1 = "BP01LEFY";
            var _skuDT = "SDNLSESY";

            // Setup product options and colors based on SKU
            setupProductOptionsForPayment(resultAPI.data);
            setupProductEventHandlers(resultAPI.data);

            function setupProductOptionsForPayment(data) {
                if (data.productItems && data.productItems.length > 0) {
                    var _arr = [];
                    if (data.sku === _skuDT) {
