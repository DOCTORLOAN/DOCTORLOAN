@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $("#nav-menu-container ul li").removeClass("menu-active");
            $("#nav-menu-container ul li").eq(5).addClass("menu-active");
        });

        var swiper = new Swiper("#NewsSwiper", {
            grabCursor: true,
            centeredSlides: true,
            slidesPerView: 2,
            initialSlide: 2,
            spaceBetween: 16,
            effect: 'coverflow',
            keyboard: true,
            slideToClickedSlide: true,
            loop: true,
            autoplay: {
                delay: 3000,
                disableOnInteraction: false,
            },
            coverflowEffect: {
                rotate: 0,
                stretch: 0,
                depth: 100,
                modifier: 2,
                slideShadows: false,
            },
            breakpoints: {
                768: {
                    slidesPerView: 3,
                    initialSlide: 2,
                    spaceBetween: 50,
                    coverflowEffect: {
                        depth: 100,
                        modifier: 3,
                    },
                },
                1200: {
                    slidesPerView: 3,
                    initialSlide: 2,
                    spaceBetween: 100,
                    coverflowEffect: {
                        depth: 100,
                        modifier: 3,
                    },
                }
            },
        });

        var swiper2 = new Swiper(".socialActivities", {
            spaceBetween: 0,
            slidesPerView: 1,
            loop: true,
            autoplay: {
                delay: 3000,
                disableOnInteraction: false,
            },
            pagination: {
                el: ".swiper-pagination",
                clickable: true,
            },
            breakpoints: {
                992: {
                    spaceBetween: 10,
                    slidesPerView: 2,
                }
            },
        });

        // Redirect vs pagram
        function redirectToWithData(url, data) {
            const queryParams = $.param(data);
            const redirectUrl = queryParams ? `${url}?${queryParams}` : url;
            window.location.href = redirectUrl;
        }

        // Hàm gọi API chung
        function fetchData(url, onSuccess, onError) {
            $.ajax({
                url: url,
                type: 'GET',
                dataType: 'json',
                success: onSuccess,
                error: onError || function (error) {
                    console.error('Error:', error);
                }
            });
        }

        // Hàm xử lý các danh mục từ API
        function getCategoriesNews(data) {
            const menuNewsContainer = $("#MenuNews .list-menu-news");

            // Lặp qua các danh mục và tạo các mục trong menu
            $.each(data.items, function (_idx, _item) {
                const menuNews = $(`
                    <div class="menu-news-item" id="menu-news-item-${_item.id}">
                        <a href="javascript:void(0)">
                            ${_item.description}
                            <div class="content-menu">
                                ${_item.name}
                            </div>
                        </a>
                    </div>
                `);

                // Thêm vào danh sách menu
                menuNewsContainer.append(menuNews);

                // Gắn sự kiện click
                $(`#menu-news-item-${_item.id}`).click(function () {
                    redirectToWithData("/News/NewsDetail", { newCategoriesId: _item.id });
                });
            });
        }

        // Hàm xử lý các danh mục theo từng từ khóa
        function handleCategoryItems(items) {
            const categoryHandlers = [
                {
                    keyword: "Câu chuyện",
                    fetchFunction: (id) => getItemNewOfCategories(id),
                    clickSelector: "#news-feedback .title-news a",
                },
                {
                    keyword: "Nguyên nhân",
                    fetchFunction: (id) => getNewsOfReasonCategory(id, 1, 5),
                    clickSelector: "#Reason .title-news a",
                },
                {
                    keyword: "Thực trạng",
                    fetchFunction: (id) => getNewsOfRealityCategory(id),
                    clickSelector: "#Reality .title-news a",
                },
                {
                    keyword: "Giải pháp",
                    fetchFunction: (id) => getNewsOfSolutionCategory(id),
                    clickSelector: "#NewsSolution .title-news a",
                },
                {
                    keyword: "Hoạt động",
                    fetchFunction: (id) => getNewsSocialCategory(id),
                    clickSelector: "#NewsSocial .title-news a",
                },
            ];

            // Lặp qua danh sách items
            $.each(items, function (_idx, _item) {
                const _name = _item.name;

                // Tìm handler phù hợp
                categoryHandlers.forEach(({ keyword, fetchFunction, clickSelector }) => {
                    if (_name.includes(keyword)) {
                        // Gọi hàm fetchFunction nếu tồn tại
                        if (fetchFunction) fetchFunction(_item.id);

                        // Gắn sự kiện click
                        $(clickSelector).off("click").on("click", function () {
                            redirectToWithData("/News/NewsDetail", { newCategoriesId: _item.id });
                        });
                    }
                });
            });
        }

        // Khởi chạy khi tải trang
        $(document).ready(function () {
            // Gọi API lấy danh sách danh mục
            fetchData(
                'https://doctorloan-api.giathaidoctorloan.vn/api/news-module/NewsCategory/FilterCategories',
                function (response) {
                    // Hiển thị danh mục trong menu
                    getCategoriesNews(response.data);

                    // Xử lý logic theo từ khóa
                    handleCategoryItems(response.data.items);
                }
            );
        });

        // Get the value ItemNewOfCategoríe
        function getItemNewOfCategories(id) {
            $.ajax({
                url: 'https://doctorloan-api.giathaidoctorloan.vn/api/news-module/NewsItem/FilterNews?CategoryId=' + id,
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    var item = $(``);
                    $.each(data.data.items, function (_idx, _item) {
                        item = $(`<div id="info-feedback-${_item.id}" class="col-4" role="button">
                                        <div class="card-info">
                                            <img loading="lazy" src="${ _item.imageUrl }" />
